#version 450
#extension GL_GOOGLE_include_directive : require
#include "steam_water.glsl"
layout(local_size_x = 1) in;
struct WaterCase {
    SteamWaterState state;
    vec4 blue, clip, normal, direction, position;
};
layout(std430, set = 0, binding = 0) readonly buffer Inputs { WaterCase cases[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Outputs { vec4 results[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    WaterCase value = cases[i];
    results[i] = steamWaterPixel(value.blue.x, value.clip, value.normal.xyz, value.direction.xyz, value.position.xyz, value.state);
}
